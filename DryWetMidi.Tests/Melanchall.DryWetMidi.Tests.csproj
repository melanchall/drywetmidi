<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;ReleaseTest;ReleaseTestFull;ReleaseNativeless;DebugNativeless</Configurations>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>strongnamekey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE;TEST;FULL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='DebugNativeless'">
    <DefineConstants>DEBUG;TRACE;TEST;NATIVELESS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>FULL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseNativeless'">
    <DefineConstants>NATIVELESS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseTest'">
    <DefineConstants>TEST;FULL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseTestFull'">
    <DefineConstants>TRACE;TEST;FULL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="SendTestData.c" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DryWetMidi\Melanchall.DryWetMidi.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='ReleaseNativeless' OR '$(Configuration)'=='DebugNativeless'">
    <Compile Remove="Multimedia\**\*.cs" />
    <Compile Remove="Attributes\DevicesWatcherApiRequiredAttribute.cs" />
    <Compile Remove="Attributes\VirtualDeviceApiRequiredAttribute.cs" />
    <Compile Remove="Attributes\ParentDeviceApiRequiredAttribute.cs" />
    <Compile Remove="Attributes\MultiClientDeviceAccessSupportRequiredAttribute.cs" />
    <Compile Remove="Attributes\AdvancedApiRequiredAttribute.cs" />
    <Compile Remove="Attributes\NativeApiRequiredAttribute.cs" />
  </ItemGroup>

  <Import Project="$(SolutionDir)Melanchall.DryWetMidi.Native.targets" />

</Project>
