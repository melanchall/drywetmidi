{
  "metadata": [
    {
      "src": [
        {
          "files": [ "DryWetMidi/Melanchall.DryWetMidi.csproj" ],
          "exclude": [ "**/bin/**", "**/obj/**" ],
          "src": "../"
        }
      ],
      "dest": "obj/api",
      "shouldSkipMarkup": true,
      "properties": {
        "TargetFramework": "net8.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "**/*.yml" ],
        "src": "obj/api",
        "dest": "api"
      },
      {
        "files": [ "**/*.md", "**/toc.yml" ],
        "exclude": [
          "**/obsolete/OBS[0-9]*/*.md",
          "**/obsolete/OBS[0-9]*/*.yml",
          "**/obsolete/template.md"
        ]
      }
    ],
    "sitemap": {
      "baseUrl": "https://melanchall.github.io/drywetmidi",
      "priority": 0.1,
      "changefreq": "monthly"
    },
    "resource": [
      {
        "files": [
          "images/**",
          "articles/**/images/**",
		      "articles/**/*.mid",
          "robots.txt"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "DryWetMIDI",
      "_enableSearch": true,
      "_appLogoPath": "images/logo.png",
      "_appFaviconPath": "images/favicon.png",
      "_appFooter": "0000 / Generated by <a href=\"https://dotnet.github.io/docfx\">DocFX</a>",
      "_disableContribution": true
    },
    "template": [
      "default",
	    "templates/dwm"
    ],
    "markdownEngineName": "markdig",
    "dest": "_site",
    "xrefService": [ "https://xref.docs.microsoft.com/query?uid={uid}" ],
	  "xref": [
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ]
  }
}
