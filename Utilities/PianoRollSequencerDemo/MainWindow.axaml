<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Melanchall.PianoRollSequencerDemo.MainWindow"
        Title="DryWetMidi Avalonia Piano Roll Demo"
        Width="1320"
        Height="780"
        MinWidth="980"
        MinHeight="560"
        UseLayoutRounding="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0F1626" Padding="12" BorderBrush="#2C4F8A" BorderThickness="0,0,0,1">
      <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal" ItemHeight="34" VerticalAlignment="Center">
          <Button x:Name="PlayButton" Content="▶ Play" MinWidth="116" Padding="10,4" Margin="0,0,8,0" Background="#1D4ED8" Foreground="White" />
          <Button x:Name="ResetButton" Content="Reset Position" MinWidth="136" Padding="10,4" Margin="0,0,8,0" Background="#1E3A8A" Foreground="White" />
          <Button x:Name="ClearButton" Content="Clear" MinWidth="92" Padding="10,4" Margin="0,0,16,0" Background="#991B1B" Foreground="White" />

          <TextBlock VerticalAlignment="Center" Foreground="#D4E2FF" Text="Grid:" Margin="0,0,6,0" />
          <ComboBox x:Name="GridStepComboBox" MinWidth="120" Margin="0,0,12,0" />

          <TextBlock VerticalAlignment="Center" Foreground="#D4E2FF" Text="Time format:" Margin="0,0,6,0" />
          <ComboBox x:Name="TimeFormatComboBox" MinWidth="160" Margin="0,0,12,0" />

          <TextBlock VerticalAlignment="Center" Foreground="#D4E2FF" Text="Time signature:" Margin="0,0,6,0" />
          <ComboBox x:Name="TimeSignatureComboBox" MinWidth="120" />
        </WrapPanel>

        <WrapPanel Orientation="Horizontal" ItemHeight="34" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Foreground="#D4E2FF" Text="Output:" Margin="0,0,6,0" />
          <ComboBox x:Name="OutputEndpointComboBox" MinWidth="260" Margin="0,0,12,0" />

          <TextBlock VerticalAlignment="Center" Foreground="#D4E2FF" Text="Tools:" Margin="0,0,6,0" />
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,0">
            <Button x:Name="DrawToolButton" MinWidth="96" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="12" Height="12" Stretch="Uniform" Fill="White" Data="M1,10 L2.4,11.4 L0,12 Z M3.2,10.6 L1.4,8.8 L8.7,1.5 C9.4,0.8 10.5,0.8 11.2,1.5 L11.7,2 C12.4,2.7 12.4,3.8 11.7,4.5 Z" />
                <TextBlock Text="Draw" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="CutToolButton" MinWidth="84" Padding="8,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Width="12" Height="12" Stretch="Uniform" Fill="White" Data="M2.2,1.2 C3.2,1.2 4,2 4,3 C4,4 3.2,4.8 2.2,4.8 C1.2,4.8 0.4,4 0.4,3 C0.4,2 1.2,1.2 2.2,1.2 Z M2.2,7.2 C3.2,7.2 4,8 4,9 C4,10 3.2,10.8 2.2,10.8 C1.2,10.8 0.4,10 0.4,9 C0.4,8 1.2,7.2 2.2,7.2 Z M3.8,4.4 L12,12 M3.8,7.6 L12,0" />
                <TextBlock Text="Cut" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <CheckBox x:Name="SnapCheckBox" Content="Snap to grid" Foreground="#D4E2FF" VerticalAlignment="Center" IsChecked="True" />
        </WrapPanel>

        <Border Background="#102746" Padding="8" CornerRadius="4" BorderBrush="#2E62AE" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <TextBlock Foreground="#C7D9FF" Text="Current playback time:" VerticalAlignment="Center" />
            <TextBlock x:Name="CurrentTimeText" Grid.Column="1" Foreground="#60A5FA" FontWeight="SemiBold" VerticalAlignment="Center" Text="0" />
          </Grid>
        </Border>

        <TextBlock Foreground="#BFD0F1"
                   Text="Draw tool: double-click or drag to create notes, drag notes to move, right-click to remove. Cut tool: click a note to split at cursor. Snap keeps edits on grid." />

        <TextBlock x:Name="StatusText" Foreground="#E8E8E8" Text="Ready" />
      </StackPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Visible"
                  VerticalScrollBarVisibility="Visible">
      <Grid x:Name="PianoRollHost" ColumnDefinitions="96,*" Background="#0E1624">
        <Canvas x:Name="KeysCanvas" Background="#131313" />

        <Grid Grid.Column="1" ClipToBounds="True">
          <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
          <Canvas x:Name="NotesCanvas" Background="Transparent" />
        </Grid>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
